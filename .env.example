# Copia este fichero a .env. Todo es opcional salvo una fuente de lanzamientos.

# ── Fuente: Muspy (lo más sencillo) ─────────────────────────────────────────
# Tu ID son 30 caracteres: está en el enlace del feed de muspy.com, /feed?id=...
MUSPY_USERID=
MUSPY_SINCE_DAYS=21
MUSPY_TYPES=Album,EP

# ── NAS de música compartida ────────────────────────────────────────────────
# Sin esto los discos se muestran igualmente, pero sin descargas ni pestaña Top 10.
NAS_URL=
NAS_API_KEY=
# Carpeta del host que vigila tu cliente de torrents
WATCH_TORRENTS_HOST_PATH=./data/watch_torrents

# ── Qué discos ya tienes (se ocultan) ───────────────────────────────────────
AIRSONIC_URL=
AIRSONIC_USER=
AIRSONIC_PASS=
AIRSONIC_SCAN_URL=
QB_HOST=
QB_PORT=8080
QB_USER=
QB_PASS=

# ── Fuente alternativa: calendario CalDAV (Radicale) ────────────────────────
RADICALE_URL=
RADICALE_USERNAME=
RADICALE_PW=
RADICALE_CALENDAR=
CALENDAR_NAME=
CALENDAR_TASKS=

# ── Información de artista y disco ──────────────────────────────────────────
LASTFM_API_KEY=
LASTFM_USERNAME=
MB_EMAIL=

# Contraseña del panel ⚙: imprescindible para ver o cambiar credenciales desde la web
SETTINGS_PASSWORD=

# Tu usuario, para que los ficheros de data/ no queden como root
PUID=1000
PGID=1000
